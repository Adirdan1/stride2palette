# ---------------------------------------------------------------------------
# Supabase. Server-side only — the service role key bypasses RLS by design and
# must never reach the browser, so neither of these carries a NEXT_PUBLIC_
# prefix. This app has its own Supabase project rather than a schema inside the
# shared one, because it is the first app in the collection where more than one
# person logs in; see the skill file for the full reasoning.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://niyfawkpjlkrspyutjmx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# The secret every session cookie is signed with. Any long random string —
# `openssl rand -base64 48` is fine. It is not a PIN and nobody types it.
#
# Rotating it signs everyone out, which is the intended way to revoke every
# session at once. If this is unset in production the app seals itself rather
# than serving the venue's finances to anyone with the URL.
# ---------------------------------------------------------------------------
PALETTE_SECRET=

# ---------------------------------------------------------------------------
# Creates the very first account, and nothing else.
#
# It is only accepted while the `users` table is empty, so it cannot be used as
# a back door once somebody exists — a stolen key buys an attacker nothing on a
# running app. Set it, create your account, then leave it or clear it; either
# way it stops working the moment that first account exists.
# ---------------------------------------------------------------------------
PALETTE_BOOTSTRAP_KEY=

# ---------------------------------------------------------------------------
# The venue's local timezone. The only thing it decides is which calendar date
# "now" falls on — see the single timezone-aware function in lib/core.js.
# ---------------------------------------------------------------------------
PALETTE_TIMEZONE=Asia/Jerusalem
